# Copy to .env and fill. Never commit .env.

# --- Local models (Ollama) ---
OLLAMA_HOST=http://localhost:11434
PLATE_MODEL=gemma4              # vision model for rating plates; fallback gemma3:4b
EMBED_MODEL=embeddinggemma      # 300M open embedding model
EMBED_DIM=768                   # check `ollama show embeddinggemma` and match sql/schema.sql
ANSWER_MODEL=manual-labor-4b    # the merged Tinker LoRA imported into Ollama; baseline: qwen3.5:4b
BASELINE_GEMMA=gemma4

# --- Tiger Data (free service; Console > service > connection string) ---
TIGER_DATABASE_URL=postgres://tsdbadmin:CHANGE_ME@CHANGE_ME.tsdb.cloud.timescale.com:5432/tsdb?sslmode=require
KEYWORD_SEARCH=bm25             # bm25 (pg_textsearch) or tsvector (fallback)

# --- Ultramarine (Paper Instruments). $5 promo only: hacktoberfest.com/my/promos. No auto top-up. ---
PAPERINSTRUMENTS_API_KEY=
ULTRAMARINE_BASE_URL=https://api.paperinstruments.com/v1
ULTRAMARINE_MODEL=ultramarine-1-flash
ULTRAMARINE_EFFORT=high         # low | high | max

# --- Tinker (training) ---
TINKER_API_KEY=
TINKER_BASE_MODEL=Qwen/Qwen3.5-4B
TINKER_CHECKPOINT=              # tinker://<run>/sampler_weights/<name> after training
TINKER_OAI_BASE_URL=https://tinker.thinkingmachines.dev/services/tinker-prod/oai/api/v1

# --- SerpApi (free: 250 searches/month) ---
SERPAPI_API_KEY=

# --- Browserbase + Stagehand (free: 1 browser-hour total) ---
BROWSERBASE_API_KEY=
USE_BROWSERBASE=0               # 0 = local Chrome while developing, 1 = Browserbase session
STAGEHAND_MODEL=groq/openai/gpt-oss-120b
STAGEHAND_MODEL_API_KEY=        # e.g. your Groq key; or leave empty and set STAGEHAND_MODEL=local to use the Ollama callback

# --- Temporal (local dev server) ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=manual-labor
NTFY_TOPIC=                     # pick a long random topic name; ntfy.sh is public by topic

# --- Auth0 for AI Agents (stretch; CIBA + Guardian push) ---
AUTH0_DOMAIN=                   # your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_USER_SUB=                 # auth0|... of the approver (enrolled in Guardian)

# --- Web page ---
WEB_HOST=0.0.0.0
WEB_PORT=8000
